---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ruilong Ren (任瑞龙)',
  description = 'Ruilong Ren - Large Model Algorithm Engineer at Autel Robotics. Research notes, reading logs, and finance learning.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ruilong Ren" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteNav />
    <main class="page">
      <div class="card">
        <slot />
      </div>
    </main>
  </body>
</html>
