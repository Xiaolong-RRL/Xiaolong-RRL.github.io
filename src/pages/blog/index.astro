---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Blog · Ruilong Ren" description="Technical notes and project write-ups.">
  <header class="page-header">
    <h1>Blog</h1>
    <p>Technical notes and project write-ups.</p>
  </header>

  {posts.length === 0 ? (
    <div class="empty-state">
      <p>还没有内容。在 <code>src/content/blog</code> 下新建 Markdown 即可发布。</p>
      <p>示例文件名：<code>hello-world.md</code>，并写上 title / date 等 frontmatter。</p>
    </div>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-CA')}
            </time>
            {post.data.description ? ` · ${post.data.description}` : ''}
          </div>
          {post.data.tags?.length ? (
            <div class="post-tags">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          ) : null}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
